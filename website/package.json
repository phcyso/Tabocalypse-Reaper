{
  "name": "tabocalypse-reaper-website",
  "version": "1.0.0",
  "description": "GitHub Pages website for Tabocalypse Reaper browser extension",
  "scripts": {
    "dev": "concurrently \"npm run dev:css\" \"npm run dev:ts\"",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "dev:ts": "tsc --watch",
    "build": "npm run build:css && npm run build:ts && npm run copy:assets",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build:ts": "tsc",
    "copy:assets": "cp src/index.html dist/ && cp -r assets dist/"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "firefox",
    "extension",
    "tabs",
    "browser"
  ],
  "author": "",
  "license": "MIT"
}
