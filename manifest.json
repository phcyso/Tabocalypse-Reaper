{
  "manifest_version": 2,
  "name": "Tabocalypse Reaper",
  "version": "0.4.6",
  "description": "Funny chaos-controller for tabs. Groups by host → cluster, shows icons, and lets you reap entire groups.",
  "permissions": [
    "tabs",
    "storage",
    "theme"
  ],
  "browser_action": {
    "default_title": "Tabocalypse Reaper",
    "default_popup": "popup.html"
  },
  "applications": {
    "gecko": {
      "id": "tabocalypse-reaper@example.com",
      "strict_min_version": "78.0"
    }
  }
}
